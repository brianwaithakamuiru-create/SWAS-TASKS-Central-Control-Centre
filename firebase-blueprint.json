{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized Super Administrator or department staff account and RBAC permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 32 },
        "emailVerified": { "type": "boolean" },
        "phoneVerified": { "type": "boolean" },
        "primaryDepartment": {
          "type": "string",
          "enum": [
            "all",
            "user_management",
            "client_management",
            "task_monitoring",
            "bids_assignments",
            "finance_control",
            "api_management",
            "activity_logs",
            "platform_settings"
          ]
        },
        "role": { "type": "string", "minLength": 2, "maxLength": 80 },
        "status": { "type": "string", "enum": ["pending_verification", "active", "rejected", "suspended", "deactivated", "revoked"] },
        "verificationStatus": { "type": "string", "enum": ["pending_verification", "approved", "rejected"] },
        "accessStatus": { "type": "string", "enum": ["inactive", "active", "blocked"] },
        "departments": { "type": "array" },
        "actions": { "type": "array" },
        "invitationId": { "type": "string", "maxLength": 128 },
        "invitationType": { "type": "string", "enum": ["staff_account", "department_member", "department_admin"] },
        "registeredAt": { "type": "string", "maxLength": 64 },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedByName": { "type": "string", "maxLength": 140 },
        "approvedAt": { "type": "string", "maxLength": 64 },
        "rejectedBy": { "type": "string", "maxLength": 128 },
        "rejectedByName": { "type": "string", "maxLength": 140 },
        "rejectedAt": { "type": "string", "maxLength": 64 },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "sessionRevokedAt": { "type": "string", "maxLength": 64 },
        "lastLoginAt": { "type": "string", "maxLength": 64 },
        "mfaEnabled": { "type": "boolean" },
        "failedAttempts": { "type": "number" },
        "lockedUntil": { "type": "string", "maxLength": 64 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "notificationPrefs": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["uid", "email", "displayName", "role", "status", "departments", "actions", "createdAt", "updatedAt"]
    },
    "StaffInvitation": {
      "title": "StaffInvitation",
      "description": "Time-limited, department-locked staff invitation with short shareable code hash.",
      "type": "object",
      "properties": {
        "invitationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "shortCode": { "type": "string", "minLength": 6, "maxLength": 32 },
        "codeHash": { "type": "string", "minLength": 32, "maxLength": 128 },
        "tokenHash": { "type": "string", "minLength": 32, "maxLength": 128 },
        "invitationType": { "type": "string", "enum": ["staff_account", "department_member", "department_admin"] },
        "fullName": { "type": "string", "maxLength": 140 },
        "email": { "type": "string", "maxLength": 254 },
        "emailRestricted": { "type": "boolean" },
        "phone": { "type": "string", "maxLength": 32 },
        "requiresPhone": { "type": "boolean" },
        "singleUse": { "type": "boolean" },
