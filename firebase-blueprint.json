        "codeHash": { "type": "string", "minLength": 32, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invitationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invitationType": { "type": "string", "enum": ["staff_account", "department_member", "department_admin"] },
        "department": {
          "type": "string",
          "enum": [
            "user_management",
            "client_management",
            "task_monitoring",
            "bids_assignments",
            "finance_control",
            "api_management",
            "activity_logs",
            "platform_settings"
          ]
        },
        "departmentLabel": { "type": "string", "maxLength": 120 },
        "departmentRole": { "type": "string", "minLength": 2, "maxLength": 80 },
        "inviterName": { "type": "string", "maxLength": 140 },
        "emailRestricted": { "type": "boolean" },
        "requiresPhone": { "type": "boolean" },
        "singleUse": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "opened", "accepted", "expired", "revoked"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["codeHash", "invitationId", "department", "departmentRole", "emailRestricted", "singleUse", "status", "expiresAt", "createdAt", "updatedAt"]
    },
    "StaffVerificationAudit": {
      "title": "StaffVerificationAudit",
      "description": "Immutable Super Admin review and approval/rejection audit log for newly registered staff accounts.",
      "type": "object",
      "properties": {
        "auditId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
