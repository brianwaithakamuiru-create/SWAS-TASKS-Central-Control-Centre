          "type": "string",
          "enum": [
            "user_management",
            "client_management",
            "task_monitoring",
            "bids_assignments",
            "finance_control",
            "api_management",
            "activity_logs",
            "platform_settings"
          ]
        },
        "departmentRole": { "type": "string", "minLength": 2, "maxLength": 80 },
        "permissions": { "type": "array" },
        "shareMessage": { "type": "string", "maxLength": 1000 },
        "inviterName": { "type": "string", "maxLength": 140 },
        "status": { "type": "string", "enum": ["pending", "opened", "accepted", "expired", "revoked"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "openedAt": { "type": "string", "maxLength": 64 },
        "openedCount": { "type": "number" },
        "acceptedCount": { "type": "number" },
        "emailDeliveryStatus": { "type": "string", "enum": ["sent", "not_configured", "failed", "not_sent"] },
        "acceptedByUid": { "type": "string", "maxLength": 128 },
        "acceptedByEmail": { "type": "string", "maxLength": 254 },
        "acceptedAt": { "type": "string", "maxLength": 64 },
        "revokedBy": { "type": "string", "maxLength": 128 },
        "revokedAt": { "type": "string", "maxLength": 64 },
        "revokeReason": { "type": "string", "maxLength": 500 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["invitationId", "tokenHash", "department", "departmentRole", "permissions", "status", "expiresAt", "createdBy", "createdAt", "updatedAt"]
    },
