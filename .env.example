# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PUBLIC_WEBSITE_URL: URL of the connected SWAS TASKS public website
PUBLIC_WEBSITE_URL=

# ALLOWED_ORIGINS: Comma-separated explicit origins permitted for CORS API calls
ALLOWED_ORIGINS=

# API_KEY_HMAC_SECRET: Server-side HMAC secret for hashing & verifying API keys
API_KEY_HMAC_SECRET=

# INVITATION_SIGNING_SECRET: Server-side secret for signing & hashing single-use staff invitations
INVITATION_SIGNING_SECRET=

# BOOTSTRAP_SUPER_ADMIN_EMAIL: Initial Super Administrator email authorized on first sign-in
BOOTSTRAP_SUPER_ADMIN_EMAIL=brianwaithakamuiru@gmail.com

# Official Platform Email Identity (used across Public Website & Central Control Centre)
OFFICIAL_PLATFORM_EMAIL=swastaskorg@gmail.com
EMAIL_SENDER_NAME=SWAS TASKS
EMAIL_REPLY_TO=swastaskorg@gmail.com

# Gmail / SMTP Delivery Service (Server-Side Only - Never expose in frontend)
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Alternative Email Delivery Provider (Resend HTTPS API - Server-Side Only)
RESEND_API_KEY=
EMAIL_FROM=

# Optional SMS Verification Provider (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Payment Gateway (Safaricom M-Pesa Daraja API - Server-Side Only)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

